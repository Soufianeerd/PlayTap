    { "atMs": 25000, "repeatIndex": 0, "phase": "REST", "phaseElapsedMs": 5000,  "phaseRemainingMs": 5000,  "status": "RUNNING" },
    { "atMs": 35000, "repeatIndex": 1, "phase": "WORK", "phaseElapsedMs": 5000,  "phaseRemainingMs": 15000, "status": "RUNNING" },
