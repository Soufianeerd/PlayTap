{
  "schemaVersion": 1,
  "id": "petanque_undo",
  "engine": "score",
  "description": "Undo removes the entire last mène as one unit (a mène awards 1-6 points in a single POINT_SCORED event), not a single point — verifies team_a's undo drops the full +3 mène, not just 1 point of it.",
  "config": {
    "schemaVersion": 1,
    "mode": "TEAM_SCORE",
    "sides": ["team_a", "team_b"],
    "allowedIncrements": [1, 2, 3, 4, 5, 6],
    "target": { "targetScore": 13, "automaticCompletion": true }
  },
  "events": [
    { "id": "e1", "originDevice": "phone", "originSequence": 1, "tOffsetMs": 0,     "type": "POINT_SCORED", "payload": { "side": "team_a", "amount": 2 } },
    { "id": "e2", "originDevice": "phone", "originSequence": 2, "tOffsetMs": 20000, "type": "POINT_SCORED", "payload": { "side": "team_b", "amount": 1 } },
    { "id": "e3", "originDevice": "phone", "originSequence": 3, "tOffsetMs": 40000, "type": "POINT_SCORED", "payload": { "side": "team_a", "amount": 3 } },
    { "id": "e4", "originDevice": "phone", "originSequence": 4, "tOffsetMs": 60000, "type": "UNDO", "payload": {} }
  ],
  "expected": {
    "scores": { "team_a": 2, "team_b": 1 },
    "matchComplete": false,
    "winner": null,
    "appliedEventCount": 3
  }
}
