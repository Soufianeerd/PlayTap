{
  "schemaVersion": 1,
  "id": "petanque_recovery_projection",
  "engine": "score",
  "description": "A full persisted event log — several mènes, an undo, play resuming, then the game completing by overshoot — replayed in one pass. Crash recovery (see playtap-offline-first) never trusts a snapshot: it re-derives state by replaying exactly this kind of persisted log, so a correct projection over the full log is what recovery depends on.",
  "config": {
    "schemaVersion": 1,
    "mode": "TEAM_SCORE",
    "sides": ["team_a", "team_b"],
    "allowedIncrements": [1, 2, 3, 4, 5, 6],
    "target": { "targetScore": 13, "automaticCompletion": true }
  },
  "events": [
    { "id": "e1",  "originDevice": "phone", "originSequence": 1,  "tOffsetMs": 0,      "type": "POINT_SCORED", "payload": { "side": "team_a", "amount": 3 } },
    { "id": "e2",  "originDevice": "phone", "originSequence": 2,  "tOffsetMs": 20000,  "type": "POINT_SCORED", "payload": { "side": "team_b", "amount": 2 } },
    { "id": "e3",  "originDevice": "phone", "originSequence": 3,  "tOffsetMs": 40000,  "type": "POINT_SCORED", "payload": { "side": "team_a", "amount": 5 } },
    { "id": "e4",  "originDevice": "phone", "originSequence": 4,  "tOffsetMs": 60000,  "type": "UNDO", "payload": {} },
    { "id": "e5",  "originDevice": "phone", "originSequence": 5,  "tOffsetMs": 80000,  "type": "POINT_SCORED", "payload": { "side": "team_a", "amount": 1 } },
    { "id": "e6",  "originDevice": "phone", "originSequence": 6,  "tOffsetMs": 100000, "type": "POINT_SCORED", "payload": { "side": "team_b", "amount": 6 } },
    { "id": "e7",  "originDevice": "phone", "originSequence": 7,  "tOffsetMs": 120000, "type": "POINT_SCORED", "payload": { "side": "team_b", "amount": 3 } }
  ],
  "expected": {
    "scores": { "team_a": 4, "team_b": 11 },
    "matchComplete": false,
    "winner": null,
    "appliedEventCount": 6
  }
}
