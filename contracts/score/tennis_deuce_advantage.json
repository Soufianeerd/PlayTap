{
  "schemaVersion": 1,
  "id": "tennis_deuce_advantage",
  "engine": "score",
  "description": "SEQUENTIAL_SCORE reaching deuce (40-40), advantage swinging both ways, then a win-by-2 game close. Verifies WIN_BY margin logic at the game level.",
  "config": {
    "schemaVersion": 1,
    "mode": "SEQUENTIAL_SCORE",
    "sequence": ["0", "15", "30", "40", "GAME"],
    "sets": { "enabled": true, "gamesToWinSet": 6 },
    "bestOf": 3,
    "winBy": { "enabled": true, "margin": 2 },
    "sides": ["side_a", "side_b"]
  },
  "events": [
    { "id": "e1", "originDevice": "phone", "originSequence": 1, "tOffsetMs": 0,     "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e2", "originDevice": "phone", "originSequence": 2, "tOffsetMs": 1000,  "type": "POINT_SCORED", "payload": { "side": "side_b" } },
    { "id": "e3", "originDevice": "phone", "originSequence": 3, "tOffsetMs": 2000,  "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e4", "originDevice": "phone", "originSequence": 4, "tOffsetMs": 3000,  "type": "POINT_SCORED", "payload": { "side": "side_b" } },
    { "id": "e5", "originDevice": "phone", "originSequence": 5, "tOffsetMs": 4000,  "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e6", "originDevice": "phone", "originSequence": 6, "tOffsetMs": 5000,  "type": "POINT_SCORED", "payload": { "side": "side_b" } },
    { "id": "e7", "originDevice": "phone", "originSequence": 7, "tOffsetMs": 6000,  "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e8", "originDevice": "phone", "originSequence": 8, "tOffsetMs": 7000,  "type": "POINT_SCORED", "payload": { "side": "side_b" } },
    { "id": "e9", "originDevice": "phone", "originSequence": 9, "tOffsetMs": 8000,  "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e10","originDevice": "phone", "originSequence": 10,"tOffsetMs": 9000,  "type": "POINT_SCORED", "payload": { "side": "side_a" } }
  ],
  "expected": {
    "currentGame": { "side_a": "0", "side_b": "0" },
    "currentSet": { "gamesWon": { "side_a": 1, "side_b": 0 } },
    "setsWon": { "side_a": 0, "side_b": 0 },
    "matchComplete": false,
    "winner": null,
    "intermediateStates": [
      { "afterEvent": "e6", "label": { "side_a": "40", "side_b": "40" }, "note": "deuce" },
      { "afterEvent": "e7", "label": { "side_a": "ADV", "side_b": "40" }, "note": "advantage side_a" },
      { "afterEvent": "e8", "label": { "side_a": "40", "side_b": "40" }, "note": "back to deuce" },
      { "afterEvent": "e9", "label": { "side_a": "ADV", "side_b": "40" }, "note": "advantage side_a" },
      { "afterEvent": "e10", "note": "side_a wins the game by a 2-point margin" }
    ]
  }
}
