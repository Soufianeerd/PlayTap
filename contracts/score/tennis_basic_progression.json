{
  "schemaVersion": 1,
  "id": "tennis_basic_progression",
  "engine": "score",
  "description": "SEQUENTIAL_SCORE (tennis game) straight progression 0-15-30-40-Game with no deuce, verifying point label sequencing and game-win reset.",
  "config": {
    "schemaVersion": 1,
    "mode": "SEQUENTIAL_SCORE",
    "sequence": ["0", "15", "30", "40", "GAME"],
    "sets": { "enabled": true, "gamesToWinSet": 6 },
    "bestOf": 3,
    "winBy": { "enabled": true, "margin": 2 },
    "sides": ["side_a", "side_b"]
  },
  "events": [
    { "id": "e1", "originDevice": "phone", "originSequence": 1, "tOffsetMs": 0, "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e2", "originDevice": "phone", "originSequence": 2, "tOffsetMs": 1000, "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e3", "originDevice": "phone", "originSequence": 3, "tOffsetMs": 2000, "type": "POINT_SCORED", "payload": { "side": "side_a" } },
    { "id": "e4", "originDevice": "phone", "originSequence": 4, "tOffsetMs": 3000, "type": "POINT_SCORED", "payload": { "side": "side_a" } }
  ],
  "expected": {
    "currentGame": { "side_a": "0", "side_b": "0" },
    "currentSet": { "gamesWon": { "side_a": 1, "side_b": 0 } },
    "setsWon": { "side_a": 0, "side_b": 0 },
    "matchComplete": false,
    "winner": null
  }
}
