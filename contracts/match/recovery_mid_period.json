{
  "schemaVersion": 1,
  "id": "recovery_mid_period",
  "engine": "match",
  "description": "MatchEngine.replay is a pure function of (rule, eventsSoFar, nowMs): replaying the exact same short event log at different checkpoint instants (simulating an app relaunch mid-period, at various delays) always reproduces the correct elapsed/status for that instant.",
  "config": {
    "matchRule": {
      "schemaVersion": 1,
      "rulesetId": "basketball.fiba.2024",
      "scoreRule": {
        "schemaVersion": 1,
        "mode": "TEAM_SCORE",
        "sides": [
          "team_a",
          "team_b"
        ],
        "allowedIncrements": [
          1,
          2,
          3
        ]
      },
      "clock": "STOPPED_CLOCK",
      "periods": [
        {
          "index": 0,
          "durationMs": 600000
        },
        {
          "index": 1,
          "durationMs": 600000
        },
        {
          "index": 2,
          "durationMs": 600000
        },
        {
          "index": 3,
          "durationMs": 600000
        }
      ],
      "matchEnd": {
        "drawAllowed": false
      },
      "overtime": {
        "durationMs": 300000
      }
    }
  },
  "events": [
    {
      "id": "ps0",
      "originDevice": "phone",
      "originSequence": 1,
      "tOffsetMs": 0,
      "type": "PERIOD_STARTED",
      "payload": {
        "periodIndex": 0,
        "kind": "REGULATION"
      }
    },
    {
      "id": "ts0",
      "originDevice": "phone",
      "originSequence": 2,
      "tOffsetMs": 0,
      "type": "TIMER_STARTED",
      "payload": {}
    },
    {
      "id": "tp0",
      "originDevice": "phone",
      "originSequence": 3,
      "tOffsetMs": 30000,
      "type": "TIMER_PAUSED",
      "payload": {}
    },
    {
      "id": "tr0",
      "originDevice": "phone",
      "originSequence": 4,
      "tOffsetMs": 45000,
      "type": "TIMER_RESUMED",
      "payload": {}
    }
  ],
  "expectedCheckpoints": [
    {
      "atMs": 40000,
      "clock": {
        "status": "PAUSED",
        "elapsedMs": 30000
      }
    },
    {
      "atMs": 50000,
      "clock": {
        "status": "RUNNING",
        "elapsedMs": 35000
      }
    }
  ]
}
