{
  "schemaVersion": 1,
  "id": "stopped_clock_pause",
  "engine": "match",
  "description": "Basketball STOPPED_CLOCK: paused mid-period, elapsed stays frozen no matter how large the real-world gap before the next checkpoint is \u2014 excluded entirely, not adjusted by an approximate offset (mirrors the Timer engine's identical pause_resume.json fixture).",
  "config": {
    "matchRule": {
      "schemaVersion": 1,
      "rulesetId": "basketball.fiba.2024",
      "scoreRule": {
        "schemaVersion": 1,
        "mode": "TEAM_SCORE",
        "sides": [
          "team_a",
          "team_b"
        ],
        "allowedIncrements": [
          1,
          2,
          3
        ]
      },
      "clock": "STOPPED_CLOCK",
      "periods": [
        {
          "index": 0,
          "durationMs": 600000
        },
        {
          "index": 1,
          "durationMs": 600000
        },
        {
          "index": 2,
          "durationMs": 600000
        },
        {
          "index": 3,
          "durationMs": 600000
        }
      ],
      "matchEnd": {
        "drawAllowed": false
      },
      "overtime": {
        "durationMs": 300000
      }
    }
  },
  "events": [
    {
      "id": "ps0",
      "originDevice": "phone",
      "originSequence": 1,
      "tOffsetMs": 0,
      "type": "PERIOD_STARTED",
      "payload": {
        "periodIndex": 0,
        "kind": "REGULATION"
      }
    },
    {
      "id": "ts0",
      "originDevice": "phone",
      "originSequence": 2,
      "tOffsetMs": 0,
      "type": "TIMER_STARTED",
      "payload": {}
    },
    {
      "id": "tp0",
      "originDevice": "phone",
      "originSequence": 3,
      "tOffsetMs": 60000,
      "type": "TIMER_PAUSED",
      "payload": {}
    }
  ],
  "expectedCheckpoints": [
    {
      "atMs": 65000,
      "clock": {
        "status": "PAUSED",
        "elapsedMs": 60000
      }
    },
    {
      "atMs": 999999999,
      "clock": {
        "status": "PAUSED",
        "elapsedMs": 60000
      }
    }
  ]
}
