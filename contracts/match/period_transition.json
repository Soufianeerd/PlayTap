          "team_a",
          "team_b"
        ],
        "allowedIncrements": [
          1,
          2,
          3
        ]
      },
      "clock": "STOPPED_CLOCK",
      "periods": [
        {
          "index": 0,
          "durationMs": 600000
        },
        {
          "index": 1,
          "durationMs": 600000
        },
        {
          "index": 2,
          "durationMs": 600000
        },
        {
          "index": 3,
          "durationMs": 600000
        }
      ],
      "matchEnd": {
        "drawAllowed": false
      },
      "overtime": {
        "durationMs": 300000
      }
    }
  },
  "events": [
